# updated-at: 2026-11-19T10:51:17Z
# rule-count: 2
# source: https://support.apple.com/en-us/101555
# source: https://royli.dev/blog/2019/better-proxy-rules-for-apple-services
# source: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/apple-cn.list

DOMAIN-SUFFIX,mzstatic.com
DOMAIN,store.storeimages.cdn-apple.com
