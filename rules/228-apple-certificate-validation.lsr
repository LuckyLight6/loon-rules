# name: apple-certificate-validation
# priority: 228
# section: apple
# description: Apple 设备的证书状态和撤销检查
# boundary: 只用官方给出的证书端点及已知 Apple 主机别名，不扩到整个 DigiCert
# created-at: 2026-11-19T08:04:26Z
# updated-at: 2026-11-20T17:51:12Z
# rule-count: 18
# source: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/apple-pki.list
# source: https://support.apple.com/en-us/101555
# source: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Loon/SystemOTA/SystemOTA.list
# source: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/apple-cn.list
# source: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/apple-update.list

DOMAIN,certs-lb.apple.com.akadns.net
DOMAIN,certs.apple.com
DOMAIN,crl-lb.apple.com.akadns.net
DOMAIN,crl.apple.com
DOMAIN,ocsp2.apple.com
DOMAIN,valid.apple.com
DOMAIN,valid.origin-apple.com.akadns.net
DOMAIN,crl3.digicert.com
DOMAIN,crl4.digicert.com
DOMAIN,ocsp.digicert.cn
DOMAIN,ocsp.digicert.com
DOMAIN,ocsp-cdn.apple.com.akadns.net
DOMAIN,ocsp-cdn.origin-apple.com.akadns.net
DOMAIN,ocsp.apple.com.akadns.net
DOMAIN,ocsp.apple.com.mwcname.com
DOMAIN-SUFFIX,ocsp-lb.apple.com.akadns.net
DOMAIN-SUFFIX,ocsp.apple.com
DOMAIN-SUFFIX,ocsp.g.aaplimg.com
