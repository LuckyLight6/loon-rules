host,nr-synthetics-production.s3.amazonaws.com,proxy
host,onenr.io,proxy
host,pa-api.newrelic-external.com,proxy
host-wildcard,*.nr-assets.net,proxy
host-wildcard,*.nr-ext.net,proxy
host,fonts.googleapis.com,proxy
host,fonts.gstatic.com,proxy
host,secure.gravatar.com,proxy
host,www.google.com,proxy
host,www.gstatic.com,proxy
host-wildcard,*.nr-data.net,proxy
host-wildcard,*.typescript.azureedge.net,proxy
host,auth.docker.io,proxy
host,production.cloudfront.docker.com,proxy
host,registry-1.docker.io,proxy
