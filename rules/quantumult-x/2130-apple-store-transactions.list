# name: apple-store-transactions
# priority: 2130
# section: apple
# description: App Store API、搜索与提示、购买与安装指令、Apple Books 商店
# boundary: 包括 iTunes 签名初始化、第三方市场安装入口和 Apple Books 门户。账户认证、App 下载和 TestFlight 分开，不包揽整个 itunes.apple.com
# created-at: 2026-11-19T08:04:26Z
# updated-at: 2026-11-22T08:35:26Z
# source: https://raw.githubusercontent.com/Repcz/Tool/X/Loon/Rules/AppStore.list
# source: https://raw.githubusercontent.com/o-ocn/loon-rules/main/rules/custom/TestFlight.list
# source: https://raw.githubusercontent.com/geekdada/surge-list/master/surgio-snippet/apple.tpl
# source: https://raw.githubusercontent.com/Bwy999/Surge/master/Ruleset/AppleService.list
# source: https://books.apple.com/us/charts
# source: https://support.apple.com/en-us/101555
# source: https://init.itunes.apple.com/bag.xml
# canonical-rule-count: 17
# rule-count: 17
# format: quantumult-x
# canonical: rules/loon/2130-apple-store-transactions.lsr

host-wildcard,*.apps.apple.com,proxy
host-wildcard,*buy.itunes.apple.com,proxy
host,sandbox.itunes.apple.com,proxy
host-suffix,appstore.com,proxy
host,bag.itunes.apple.com,proxy
host,se.itunes.apple.com,proxy
host,se-edge.itunes.apple.com,proxy
host,su.itunes.apple.com,proxy
host,upp.itunes.apple.com,proxy
host,apps.apple.com,proxy
host,itunes.apple.com,proxy
host,lookup-api.apple.com,proxy
host-suffix,appsto.re,proxy
host,books.apple.com,proxy
host-suffix,apps-marketplace.apple.com,proxy
host,fpinit.itunes.apple.com,proxy
host,search.itunes.apple.com,proxy
