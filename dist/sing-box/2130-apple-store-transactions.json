  "rules": [
    {
      "domain_regex": [
        "(?i)^.*\\.apps\\.apple\\.com$",
        "(?i)^.*buy\\.itunes\\.apple\\.com$"
      ],
      "domain": [
        "sandbox.itunes.apple.com",
        "bag.itunes.apple.com",
        "se.itunes.apple.com",
