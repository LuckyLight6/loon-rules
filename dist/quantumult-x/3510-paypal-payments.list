# format: quantumult-x
# canonical: rules/3510-paypal-payments.lsr

host-suffix,paypal.com,proxy
host-suffix,paypalobjects.com,proxy
host-suffix,paypal.me,proxy
host-suffix,paypal-corp.com,proxy
host-suffix,paypalcorp.com,proxy
