# updated-at: 2026-11-19T12:26:59Z
# source: https://support.apple.com/en-us/101555
# source: https://support.apple.com/zh-cn/111754
# source: https://dns.google/resolve?name=icloud-content.com.cn&type=SOA
# canonical-rule-count: 3
# rule-count: 3
# format: quantumult-x
# canonical: rules/2190-apple-icloud-mainland.lsr

host-suffix,apzones.com,proxy
host-suffix,icloud-content.com.cn,proxy
host-suffix,icloud.com.cn,proxy
