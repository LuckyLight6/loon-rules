# name: google-drive-and-documents
# priority: 4540
# section: google
# description: Google Drive、文档和上传下载入口
# boundary: Drive、Docs 和明确文件主机。账号归 Google 账号组，不把整个 googleusercontent.com 或 www.googleapis.com 当网盘
# created-at: 2026-11-19T10:51:17Z
# updated-at: 2026-11-20T07:54:18Z
# source: https://raw.githubusercontent.com/o-ocn/loon-rules/main/dist/GoogleDrive.lsr
# source: https://knowledge.workspace.google.com/admin/drive/drive-and-sites-firewall-and-proxy-settings
# canonical-rule-count: 10
# rule-count: 10
# format: quantumult-x
# canonical: rules/4540-google-drive-and-documents.lsr

host,drive-thirdparty.google.com,proxy
host,filepickup.google.com,proxy
host-suffix,docs.google.com,proxy
host-suffix,drive.google.com,proxy
host-suffix,googledrive.com,proxy
host,drive.usercontent.google.com,proxy
host,drive-data-export.usercontent.google.com,proxy
host,drive-data-export-eu.usercontent.google.com,proxy
host,sheets.google.com,proxy
host,slides.google.com,proxy
